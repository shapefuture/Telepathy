# Copy to .env (never commit .env). All values below are placeholders.
TELEPATHY_BOT_TOKEN=
TELEPATHY_DB_PATH=./data/telepathy.db
# Comma-separated Telegram user IDs allowed to enable/disable sources.
TELEPATHY_OWNER_IDS=
TELEPATHY_COMMUNITY_ID=default
TELEPATHY_COMMUNITY_LABEL=Community
TELEPATHY_TIMEZONE=Asia/Jerusalem
