{
  "name": "telepathy-worker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p history",
    "db:migrate:local": "wrangler d1 migrations apply telepathy --local",
    "db:migrate:remote": "wrangler d1 migrations apply telepathy --remote",
    "import": "node scripts/import-export.mjs",
    "backfill": "uv run scripts/backfill.py",
    "fed:keys": "node scripts/fed-keys.mjs",
    "fed:rotate": "node scripts/fed-rotate.mjs",
    "identity": "node scripts/identity.mjs",
    "hydra": "node scripts/hydra.mjs",
    "build:history": "node scripts/build-history.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20260930.2",
    "@mtcute/web": "0.32.4",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "@mtcute/core": "0.32.4",
    "@mtcute/wasm": "0.32.0",
    "@mtcute/tl-runtime": "0.32.0",
    "@mtcute/file-id": "0.32.0"
  }
}
