# Copy to .env (never commit .env). Values below are placeholders.
TELEPATHY_BOT_TOKEN=
# Comma-separated Telegram user IDs of community owners (required).
TELEPATHY_OWNER_IDS=
TELEPATHY_COMMUNITY_ID=default
TELEPATHY_COMMUNITY_LABEL=Community
TELEPATHY_TIMEZONE=Asia/Jerusalem
TELEPATHY_DIGEST_TIME=09:00
TELEPATHY_RETENTION_DAYS=90
TELEPATHY_DB_PATH=./data/telepathy.db
TELEPATHY_BACKUP_DIR=./data/backups
TELEPATHY_BACKUP_KEEP=14
# Optional: command that receives each verified backup path as its last argument,
# e.g. a script that encrypts with `age` and uploads with `rclone`.
TELEPATHY_BACKUP_COMMAND=
TELEPATHY_ASK_RATE_PER_MINUTE=10
