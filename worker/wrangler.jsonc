{
  // Telepathy on Cloudflare Workers (free plan). See ../docs/DEPLOY_CLOUDFLARE.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telepathy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telepathy",
      // Replace with the id printed by `wrangler d1 create telepathy`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Every 5 minutes: sends, intro expiry/reminders, digest batches, retention.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "COMMUNITY_LABEL": "Community",
    "TIMEZONE": "Asia/Jerusalem",
    "DIGEST_HOUR": "9",
    "ASK_RATE_PER_MINUTE": "10",
    // "true" queues PDF/DOCX/PPTX for the GitHub Actions parser (files pass through GitHub).
    // Approved by the community owner on 2026-10-23 (K18).
    "OFFLOAD_DOCUMENTS": "true"
  },
  // Secrets (set with `wrangler secret put NAME`, never committed):
  //   BOT_TOKEN, WEBHOOK_SECRET, ADMIN_TOKEN, OWNER_IDS
  "observability": { "enabled": true }
}
